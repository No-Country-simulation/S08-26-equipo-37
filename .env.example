# Local-only defaults used by compose.yaml. Never use these credentials in production.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/predictive_maintenance"
APP_URL="http://127.0.0.1:3000"

# Optional initial administrator. Remove all BOOTSTRAP_ADMIN_* values after the first seed.
# BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
# BOOTSTRAP_ADMIN_NAME="Administración"
# BOOTSTRAP_ADMIN_PASSWORD=""

# Transactional email; no-reply@chenodo.ar uses the existing Hostinger mailbox.
# SMTP_HOST="smtp.hostinger.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_FROM="no-reply@chenodo.ar"
# SMTP_USER="no-reply@chenodo.ar"
# SMTP_PASSWORD=""

# Optional S3-compatible object storage (for example Cloudflare R2).
# OBJECT_STORAGE_ENDPOINT="https://account-id.r2.cloudflarestorage.com"
# OBJECT_STORAGE_REGION="auto"
# OBJECT_STORAGE_BUCKET="machine-images"
# OBJECT_STORAGE_ACCESS_KEY_ID=""
# OBJECT_STORAGE_SECRET_ACCESS_KEY=""
# OBJECT_STORAGE_PUBLIC_URL="https://images.example.com"
