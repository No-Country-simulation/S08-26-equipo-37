// PredictiveMaintenance — propuesta MVP de persistencia
// Variante: 1 fila por máquina-hora.
// Integrado sobre el prisma/schema.prisma actual del repositorio.
// Prisma 7.x + PostgreSQL.
//
// Decisiones principales:
// - No se crea un Usuario paralelo: se reutiliza User existente.
// - Activo conserva solo datos relativamente estáticos.
// - LecturaMaquinaHora conserva telemetría + odómetros en cada hora.
// - Sensores son nullable para preservar faltantes como NULL.
// - PrediccionIA guarda la salida operacional del modelo, no target_* del dataset.
// - Alerta, RevisionAlerta y OrdenTrabajo están separadas.
// - Máximo una alerta activa por activo mediante índice único parcial.
// - RUL, robots, subensambles y diagnóstico multiclase quedan fuera del MVP.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// IDENTIDAD / ADMINISTRACIÓN EXISTENTE EN EL REPO
// -----------------------------------------------------------------------------

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum Theme {
  light
  dark
}

enum ScopeType {
  GLOBAL
  ORGANIZATION
  PLANT
  AREA
  MACHINE
}

model User {
  id                    String   @id @default(cuid())
  name                  String
  email                 String   @unique
  avatarUrl             String?
  theme                 Theme    @default(light)
  status                UserStatus @default(INVITED)
  passwordHash          String?
  lastLoginAt           DateTime?
  passwordChangedAt     DateTime?
  mustChangePassword    Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  disabledAt            DateTime?

  sessions              Session[]
  assignments           UserRoleAssignment[]
  resetTokens           PasswordResetToken[]

  // Relaciones del dominio de mantenimiento.
  alertasAsignadas      Alerta[]         @relation("AlertasAsignadas")
  revisionesAlerta      RevisionAlerta[] @relation("RevisionesAlerta")
  ordenesAsignadas      OrdenTrabajo[]   @relation("OrdenesAsignadas")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  permissions RolePermission[]
  assignments UserRoleAssignment[]
}

model Permission {
  id    String @id @default(cuid())
  key   String @unique
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRoleAssignment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  scopeType  ScopeType
  scopeRef   String?
  validFrom  DateTime?
  validUntil DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, scopeType, scopeRef])
  @@index([validUntil])
}

model AccessResource {
  id        String @id @default(cuid())
  scopeType ScopeType
  scopeRef  String
  name      String
  parentId  String?
  parent    AccessResource?  @relation("AccessHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children  AccessResource[] @relation("AccessHierarchy")

  @@unique([scopeType, scopeRef])
}

model Invitation {
  id              String   @id @default(cuid())
  email           String
  tokenHash       String   @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdByUserId String
  createdAt       DateTime @default(now())

  @@index([email])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuthRateLimit {
  key      String   @id
  attempts Int      @default(1)
  resetAt  DateTime
}

model MachinePresentation {
  id                  String   @id @default(cuid())
  machineRef          String   @unique
  displayNameOverride String?
  shortDescription    String?
  updatedByUserId     String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  images              MachineImage[]
}

model MachineImage {
  id                    String              @id @default(cuid())
  machinePresentationId String
  presentation          MachinePresentation @relation(fields: [machinePresentationId], references: [id], onDelete: Cascade)
  url                   String
  alt                   String
  isPrimary             Boolean             @default(false)
  sortOrder             Int                 @default(0)
  mimeType              String?
  sizeBytes             Int?
  createdByUserId       String
  createdAt             DateTime            @default(now())

  @@index([machinePresentationId, sortOrder])
}

model AuditLog {
  id          String    @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  beforeData  Json?
  afterData   Json?
  scopeType   ScopeType @default(GLOBAL)
  scopeRef    String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
  @@index([scopeType, scopeRef, createdAt])
}

// -----------------------------------------------------------------------------
// DOMINIO DE MANTENIMIENTO PREDICTIVO — MVP
// -----------------------------------------------------------------------------

enum Criticidad {
  ALTA
  MEDIA
  BAJA
}

enum EstadoSalud {
  NORMAL
  BAJO_OBSERVACION
  RIESGO_CRITICO
  PARADA_MANTENIMIENTO
}

enum AlertaEstado {
  ABIERTA
  EN_EVALUACION
  PLANIFICADA
  EN_EJECUCION
  CERRADA
}

enum AlertaResultado {
  CORRECTA
  FALSO_POSITIVO
  DESCARTADA
}

enum DecisionRevisionAlerta {
  VALIDADA
  CORREGIDA
  DESCARTADA
}

enum OrdenEstado {
  PENDIENTE_REVISION_HUMANA
  APROBADA
  RECHAZADA
  EN_EJECUCION
  COMPLETADA
}

enum OrdenPrioridad {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum CausaFalla {
  FALLO_RODAMIENTO
  FALLO_MOTOR_TERMICO
  FALLO_PRESION_BOMBA
  OTRO
}

/// Datos relativamente estáticos del activo.
/// Los odómetros NO viven aquí porque cambian por hora.
model Activo {
  id                 String     @id @default(cuid())
  codigoIdentificador String    @unique @map("codigo_identificador") // id_maquina: M-01 ... M-25
  nombre             String?
  tipoEquipo         String     @map("tipo_equipo")
  modelo             String
  marca              String
  lineaProduccion    String     @map("linea_produccion")
  antiguedadAnos     Int        @map("antiguedad_anos")
  criticidad         Criticidad
  costoParadaHoraUsd Int        @map("costo_parada_hora_usd")
  potenciaNominalKw  Float      @map("potencia_nominal_kw")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lecturas        LecturaMaquinaHora[]
  predicciones    PrediccionIA[]
  eventosFalla    EventoFalla[]
  alertas         Alerta[]
  ordenesTrabajo  OrdenTrabajo[]

  @@index([criticidad])
  @@index([lineaProduccion])
  @@map("activos")
}

/// Unidad principal de persistencia del MVP: una fila = una máquina en una hora.
/// Los sensores son opcionales para conservar un valor faltante como NULL.
/// Nunca convertir un faltante a 0 en esta tabla.
model LecturaMaquinaHora {
  id       String   @id @default(cuid())
  activoId String   @map("id_activo")
  fechaHora DateTime @db.Timestamptz(3) @map("fecha_hora")

  // Contexto operativo.
  estadoOperativo Boolean @map("estado_operativo")

  // Sensores físicos. Nullable = falta de dato real.
  cargaPct            Float? @map("carga_pct")
  velocidadRpm        Float? @map("velocidad_rpm")
  voltajeV            Float? @map("voltaje_v")
  corrienteA          Float? @map("corriente_a")
  potenciaConsumidaKw Float? @map("potencia_consumida_kw")
  temperaturaC        Float? @map("temperatura_c")
  vibracionMms        Float? @map("vibracion_mms")
  presionBar          Float? @map("presion_bar")

  // Estado histórico/odómetros en ESA hora.
  horasOperacionTotales         Int @map("horas_operacion_totales")
  ciclosAcumulados              Int @map("ciclos_acumulados")
  horasDesdeUltimoMantenimiento Int @map("horas_desde_ultimo_mantenimiento")
  conteoFallasPrevias           Int @map("conteo_fallas_previas")

  activo       Activo         @relation(fields: [activoId], references: [id], onDelete: Restrict)
  predicciones PrediccionIA[] @relation("LecturaReferenciaPrediccion")

  // Evita duplicar la misma máquina-hora al ejecutar el seed más de una vez.
  @@unique([activoId, fechaHora])
  @@index([activoId, fechaHora])
  @@index([fechaHora])
  @@map("lecturas_maquina_hora")
}

/// Salida del modelo en producción.
/// NO contiene target_falla_48h / target_rul_horas del dataset como ground truth.
model PrediccionIA {
  id                   String      @id @default(cuid())
  activoId             String      @map("id_activo")
  lecturaReferenciaId  String?     @map("id_lectura_referencia")
  fechaCalculo         DateTime    @default(now()) @db.Timestamptz(3) @map("fecha_calculo")
  versionModelo        String      @map("version_modelo")
  fallaPredicha48h     Boolean     @map("falla_predicha_48h")
  probabilidadFalla48h Float       @map("probabilidad_falla_48h")
  estadoSaludSugerido  EstadoSalud @map("estado_salud_sugerido")
  umbralAlerta         Float?      @map("umbral_alerta")

  // La API actual todavía no entrega explicabilidad; queda nullable hasta que DS la exponga.
  variablesExplicativas Json? @map("variables_explicativas")

  activo            Activo              @relation(fields: [activoId], references: [id], onDelete: Restrict)
  lecturaReferencia LecturaMaquinaHora? @relation("LecturaReferenciaPrediccion", fields: [lecturaReferenciaId], references: [id], onDelete: Restrict)
  alerta             Alerta?

  @@index([activoId, fechaCalculo])
  @@index([lecturaReferenciaId])
  @@map("predicciones_ia")
}

/// Hecho real de falla. Sirve para contrastar después si una alerta fue correcta.
/// Se construye desde falla_inicio_disparo + falla_estado_causa del dataset.
model EventoFalla {
  id          String      @id @default(cuid())
  activoId    String      @map("id_activo")
  triggeredAt DateTime    @db.Timestamptz(3) @map("triggered_at")
  causa       CausaFalla?
  repairEndAt DateTime?   @db.Timestamptz(3) @map("repair_end_at")

  activo Activo @relation(fields: [activoId], references: [id], onDelete: Restrict)

  @@unique([activoId, triggeredAt])
  @@index([activoId, triggeredAt])
  @@map("eventos_falla")
}

/// Caso operativo generado a partir de una predicción.
/// closedAt == NULL significa "alerta activa".
model Alerta {
  id                 String           @id @default(cuid())
  activoId           String           @map("id_activo")
  prediccionId       String           @unique @map("id_prediccion")
  estado             AlertaEstado     @default(ABIERTA)
  resultado          AlertaResultado?
  prioridad          OrdenPrioridad
  asignadaAUsuarioId String?          @map("asignada_a_usuario_id")
  createdAt          DateTime         @default(now()) @db.Timestamptz(3) @map("created_at")
  closedAt           DateTime?        @db.Timestamptz(3) @map("closed_at")

  activo       Activo       @relation(fields: [activoId], references: [id], onDelete: Restrict)
  prediccion   PrediccionIA @relation(fields: [prediccionId], references: [id], onDelete: Restrict)
  asignadaA    User?        @relation("AlertasAsignadas", fields: [asignadaAUsuarioId], references: [id], onDelete: Restrict)
  revisiones   RevisionAlerta[]
  ordenTrabajo OrdenTrabajo?

  @@index([activoId, estado])
  @@index([asignadaAUsuarioId, estado])

  // Regla anti-ruido: una sola alerta activa por máquina.
  // Prisma 7.4+ con previewFeatures = ["partialIndexes"].
  @@unique([activoId], where: { closedAt: null }, map: "uq_alerta_activa_por_activo")
  @@map("alertas")
}

/// Auditoría funcional de la decisión humana sobre una alerta.
/// Existe aunque la revisión termine sin crear una orden de trabajo.
model RevisionAlerta {
  id        String                  @id @default(cuid())
  alertaId  String                  @map("id_alerta")
  usuarioId String                  @map("id_usuario")
  decision  DecisionRevisionAlerta
  motivo    String
  createdAt DateTime                @default(now()) @db.Timestamptz(3) @map("created_at")

  alerta  Alerta @relation(fields: [alertaId], references: [id], onDelete: Restrict)
  usuario User   @relation("RevisionesAlerta", fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([alertaId, createdAt])
  @@index([usuarioId, createdAt])
  @@map("revisiones_alerta")
}

/// Intervención operativa. Puede nacer de una alerta validada o cargarse manualmente.
model OrdenTrabajo {
  id                 String         @id @default(cuid())
  activoId           String         @map("id_activo")
  alertaId           String?        @unique @map("id_alerta")
  tipoAccionSugerida String         @map("tipo_accion_sugerida")
  prioridad          OrdenPrioridad
  estadoOrden        OrdenEstado    @default(PENDIENTE_REVISION_HUMANA) @map("estado_orden")
  tecnicoAsignadoId  String?        @map("tecnico_asignado_id")
  notas              String?
  createdAt          DateTime       @default(now()) @db.Timestamptz(3) @map("created_at")
  closedAt           DateTime?      @db.Timestamptz(3) @map("closed_at")

  activo          Activo  @relation(fields: [activoId], references: [id], onDelete: Restrict)
  alerta          Alerta? @relation(fields: [alertaId], references: [id], onDelete: Restrict)
  tecnicoAsignado User?   @relation("OrdenesAsignadas", fields: [tecnicoAsignadoId], references: [id], onDelete: Restrict)

  @@index([activoId, estadoOrden])
  @@index([tecnicoAsignadoId, estadoOrden])
  @@map("ordenes_trabajo")
}
